#!/usr/bin/env bash
set -euo pipefail

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [[ -z "$STAGED_FILES" ]]; then
    exit 0
fi

HAS_ERRORS=0

while IFS= read -r file; do
    [[ ! -f "$file" ]] && continue

    if [[ "$file" == *.sh ]]; then
        if command -v shellcheck >/dev/null 2>&1; then
            echo "[pre-commit] Перевірка shellcheck: $file"
            if ! shellcheck "$file"; then
                HAS_ERRORS=1
            fi
        else
            echo "[pre-commit] Помилка: shellcheck не встановлено (brew install shellcheck)." >&2
            HAS_ERRORS=1
        fi
    elif [[ "$file" == *.py ]]; then
        if command -v ruff >/dev/null 2>&1; then
            echo "[pre-commit] Перевірка ruff: $file"
            if ! ruff check "$file"; then
                HAS_ERRORS=1
            fi
        elif command -v flake8 >/dev/null 2>&1; then
            echo "[pre-commit] Перевірка flake8: $file"
            if ! flake8 --max-line-length=110 "$file"; then
                HAS_ERRORS=1
            fi
        else
            echo "[pre-commit] Перевірка синтаксису python3 -m py_compile: $file"
            if ! python3 -m py_compile "$file"; then
                HAS_ERRORS=1
            fi
        fi
    fi
done <<< "$STAGED_FILES"

if [[ "$HAS_ERRORS" -ne 0 ]]; then
    echo "[pre-commit] Коміт відхилено: виправте помилки лінтера." >&2
    exit 1
fi

exit 0
